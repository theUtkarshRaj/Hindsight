# LLM provider — needed for LOCAL mode. In Cognee Cloud mode the cloud
# instance handles the LLM, so this may be optional when connected.
LLM_API_KEY=your_openai_or_other_key

# --- Cognee Cloud connection (REQUIRED for the "Best Use of Cognee Cloud" track) ---
# These are the variable names cognee.serve() actually reads. Get both
# values from your Cognee Cloud dashboard after redeeming code COGNEE-35.
# When COGNEE_SERVICE_URL is set, the app calls cognee.serve() at startup
# and ALL remember/recall/improve/forget run on the cloud instance.
COGNEE_SERVICE_URL=https://your-instance.cognee.ai
COGNEE_API_KEY=ck_your_cloud_api_key

# Required for session memory + improve()
CACHING=true
CACHE_BACKEND=fs
